#!/usr/bin/env bash
set -euo pipefail
deployment=$(cd -- "$(dirname -- "$0")" && pwd)
[[ $EUID == 0 ]] || { echo 'Run with sudo.' >&2; exit 1; }
for command in git nginx docker runuser useradd systemctl; do
    command -v "$command" >/dev/null || { echo "Missing prerequisite: $command" >&2; exit 1; }
done
[[ -x /usr/sbin/fcgiwrap && -x /usr/lib/git-core/git-http-backend ]] || {
    echo 'Install fcgiwrap and git from Debian/Ubuntu packages first.' >&2; exit 1;
}
if ! id wiki-git >/dev/null 2>&1; then
    useradd --system --user-group --home-dir /nonexistent --no-create-home --shell /usr/sbin/nologin wiki-git
fi
install -d -m 0755 /etc/wiki /usr/local/lib/wiki /usr/local/lib/wiki/hooks /srv/wiki /srv/wiki/build /srv/wiki/www /srv/wiki/www/releases
install -d -o root -g wiki-git -m 0770 /srv/wiki/queue
if [[ ! -d /srv/wiki/source.git ]]; then
    install -d -o wiki-git -g wiki-git -m 0755 /srv/wiki/source.git
    runuser -u wiki-git -- git init --bare --initial-branch=main /srv/wiki/source.git
fi
# Also migrate repositories installed by the earlier SSH-based setup.
chown -R wiki-git:wiki-git /srv/wiki/source.git
runuser -u wiki-git -- git --git-dir=/srv/wiki/source.git config receive.denyNonFastForwards true
runuser -u wiki-git -- git --git-dir=/srv/wiki/source.git config receive.denyDeletes true
runuser -u wiki-git -- git --git-dir=/srv/wiki/source.git config http.getanyfile false
runuser -u wiki-git -- git --git-dir=/srv/wiki/source.git config --unset-all http.receivepack || [[ $? == 5 ]]
runuser -u wiki-git -- git --git-dir=/srv/wiki/source.git config core.hooksPath /usr/local/lib/wiki/hooks
install -o root -g root -m 0644 /dev/null /srv/wiki/source.git/git-daemon-export-ok
install -m 0755 "$deployment/build" /usr/local/lib/wiki/build
install -m 0755 "$deployment/post-receive" /usr/local/lib/wiki/hooks/post-receive
bash "$deployment/build-renderer"
install -m 0644 "$deployment/nginx.conf" /etc/wiki/nginx.conf
install -m 0644 "$deployment/wiki-build.service" "$deployment/wiki-build.path" "$deployment/wiki-build.timer" "$deployment/wiki-nginx.service" "$deployment/wiki-git.socket" "$deployment/wiki-git.service" /etc/systemd/system/
nginx -t -c /etc/wiki/nginx.conf
systemctl daemon-reload
systemctl enable --now wiki-build.path wiki-build.timer wiki-git.socket wiki-nginx.service
# Apply configuration changes on repeated installs as well as on the first run.
systemctl try-restart wiki-git.service
systemctl reload wiki-nginx.service
