#!/usr/bin/env bash
set -Eeuo pipefail
umask 022

repository=/srv/wiki/source.git
build_root=/srv/wiki/build
web_root=/srv/wiki/www
workspace=
staging=
container=

cleanup() {
    if [[ -n "$container" ]]; then docker rm -f "$container" >/dev/null 2>&1 || true; fi
    if [[ -n "$workspace" ]]; then rm -rf -- "$workspace"; fi
    if [[ -n "$staging" ]]; then rm -rf -- "$staging"; fi
}
trap cleanup EXIT
trap 'exit 143' TERM
trap 'exit 130' INT

git_source() {
    runuser -u exedev -- git -c safe.directory="$repository" --git-dir="$repository" "$@"
}

exec 9>/run/lock/wiki-build.lock
flock 9
image=$(cat /etc/wiki/renderer-image)
if [[ ! "$image" =~ ^([^[:space:]]+@)?sha256:[0-9a-f]{64}$ ]]; then
    echo 'Renderer image must be pinned by sha256 digest or local image ID.' >&2
    exit 1
fi

while true; do
    rm -f -- /srv/wiki/queue/pending
    if ! git_source show-ref --verify --quiet refs/heads/main; then
        echo 'No main branch exists yet; waiting for the first push.'
        exit 0
    fi
    revision=$(git_source rev-parse --verify 'refs/heads/main^{commit}')
    if [[ -f /srv/wiki/deployed && -f /srv/wiki/deployed-image ]] \
        && [[ "$(cat /srv/wiki/deployed)" == "$revision" ]] \
        && [[ "$(cat /srv/wiki/deployed-image)" == "$image" ]] \
        && [[ -f "$web_root/current/index.html" ]]; then
        exit 0
    fi
    workspace=$(mktemp -d "$build_root/work.XXXXXXXXXX")
    chmod 0755 "$workspace"
    mkdir "$workspace/source"
    git_source archive --format=tar "$revision" | tar --extract --file=- --directory="$workspace/source" --no-same-owner --no-same-permissions
    chown -R 1000:1000 "$workspace"
    container="wiki-$(basename "$workspace")"
    docker run --rm --name="$container" --pull=never --network=none --user=1000:1000 \
        --cap-drop=ALL --security-opt=no-new-privileges \
        --memory=2g --cpus=2 --pids-limit=256 --read-only \
        --tmpfs=/tmp:rw,nosuid,nodev,size=512m \
        --mount="type=bind,src=$workspace,dst=/work" \
        --workdir=/work/source --env=HOME=/tmp \
        --entrypoint=quarto "$image" render . --execute --output-dir=../output
    container=
    output="$workspace/output"
    if [[ ! -d "$output" || -L "$output" || ! -f "$output/index.html" ]]; then
        echo 'Renderer did not produce an output directory with index.html.' >&2
        exit 1
    fi
    if [[ -n "$(find "$output" -mindepth 1 ! -type f ! -type d -print -quit)" ]]; then
        echo 'Renderer output contains a symlink or special file.' >&2
        exit 1
    fi
    if [[ "$(git_source rev-parse --verify 'refs/heads/main^{commit}')" != "$revision" ]]; then
        rm -rf -- "$workspace"
        workspace=
        echo "Main changed while rendering $revision; rebuilding."
        continue
    fi
    staging=$(mktemp -d "$web_root/releases/.stage.XXXXXXXXXX")
    cp -R --no-preserve=ownership,mode,timestamps -- "$output/." "$staging/"
    chown -R root:root "$staging"
    find "$staging" -type d -exec chmod 0755 {} +
    find "$staging" -type f -exec chmod 0644 {} +
    release="$(date -u +%Y%m%dT%H%M%S%N)-$revision"
    mv -- "$staging" "$web_root/releases/$release"
    staging=
    rm -f -- "$web_root/.current-new"
    ln -s "releases/$release" "$web_root/.current-new"
    mv -Tf -- "$web_root/.current-new" "$web_root/current"
    printf '%s\n' "$revision" > /srv/wiki/.deployed-new
    mv -f -- /srv/wiki/.deployed-new /srv/wiki/deployed
    printf '%s\n' "$image" > /srv/wiki/.deployed-image-new
    mv -f -- /srv/wiki/.deployed-image-new /srv/wiki/deployed-image
    retained=1
    while IFS= read -r old_release; do
        [[ "$old_release" == "$release" ]] && continue
        if (( retained < 5 )); then
            retained=$((retained + 1))
        else
            rm -rf -- "$web_root/releases/$old_release"
        fi
    done < <(find "$web_root/releases" -mindepth 1 -maxdepth 1 -type d ! -name '.*' -printf '%f\n' | sort -r)
    rm -rf -- "$workspace"
    workspace=
    echo "Deployed $revision"
done
