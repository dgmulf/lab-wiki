[Unit]
Description=Render and atomically publish the wiki
Requires=docker.service
After=docker.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=oneshot
User=root
ExecStart=/usr/local/lib/wiki/build
TimeoutStartSec=20min
UMask=0022
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/srv/wiki /run/lock
NoNewPrivileges=true
