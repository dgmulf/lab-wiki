[Unit]
Description=Research wiki Git HTTP backend
Requires=wiki-git.socket
After=wiki-git.socket

[Service]
ExecStart=/usr/sbin/fcgiwrap -f
User=wiki-git
Group=wiki-git
Environment=HOME=/nonexistent
UMask=0022
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/srv/wiki/source.git /srv/wiki/queue
NoNewPrivileges=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX
Restart=on-failure
