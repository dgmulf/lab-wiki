#!/bin/sh
# Read-only Git credential helper. Tokens are provisioned separately, one per VM.
set -eu
[ "${1:-}" = get ] || exit 0
protocol=
host=
while IFS= read -r line && [ -n "$line" ]; do
    case "$line" in
        protocol=*) protocol=${line#protocol=} ;;
        host=*) host=${line#host=} ;;
    esac
done
[ "$protocol" = https ] || exit 0
case "$host" in
    ''|*[!a-zA-Z0-9.-]*|.*) exit 0 ;;
esac
token_file="$HOME/.config/wiki-tokens/$host"
[ -r "$token_file" ] || exit 0
token=$(cat "$token_file")
[ -n "$token" ] || exit 0
printf 'username=token\npassword=%s\n' "$token"
