#!/usr/bin/env bash
set -euo pipefail
image=${1:-$(cat /etc/wiki/renderer-image)}
workspace=$(mktemp -d /tmp/wiki-renderer-check.XXXXXXXXXX)
container="wiki-check-$(basename "$workspace")"
cleanup() {
    docker rm -f "$container" >/dev/null 2>&1 || true
    rm -rf -- "$workspace"
}
trap cleanup EXIT
chmod 0755 "$workspace"
mkdir "$workspace/source"
cat > "$workspace/source/_quarto.yml" <<'YAML'
project:
  type: website
execute:
  enabled: true
YAML
cat > "$workspace/source/index.qmd" <<'QMD'
---
title: Static renderer check
jupyter: python3
execute:
  enabled: true
---

STATIC_RENDER_VERIFIED

[Local asset](asset.txt)

```{python}
#| eval: true
from pathlib import Path
Path("/work/python-executed").touch()
raise RuntimeError("Python must not execute")
```
QMD
cat > "$workspace/source/r.qmd" <<'QMD'
---
title: R code example
engine: knitr
execute:
  enabled: true
---

R_STATIC_RENDER_VERIFIED

```{r}
#| eval: true
file.create("/work/r-executed")
stop("R must not execute")
```
QMD
printf 'LOCAL_ASSET_VERIFIED\n' > "$workspace/source/asset.txt"
chown -R 1000:1000 "$workspace"
docker run --rm --name="$container" --pull=never --network=none --user=1000:1000 \
    --cap-drop=ALL --security-opt=no-new-privileges \
    --memory=2g --cpus=2 --pids-limit=256 --read-only \
    --tmpfs=/tmp:rw,nosuid,nodev,size=512m \
    --mount="type=bind,src=$workspace,dst=/work" \
    --workdir=/work/source --env=HOME=/tmp \
    --entrypoint=quarto "$image" render . --no-execute --metadata engine:markdown --output-dir=../output
grep -q STATIC_RENDER_VERIFIED "$workspace/output/index.html"
grep -q R_STATIC_RENDER_VERIFIED "$workspace/output/r.html"
grep -q 'Python must not execute' "$workspace/output/index.html"
grep -q 'R must not execute' "$workspace/output/r.html"
grep -q LOCAL_ASSET_VERIFIED "$workspace/output/asset.txt"
test ! -e "$workspace/python-executed"
test ! -e "$workspace/r-executed"
echo 'Static rendering, local assets, and disabled Python/R execution passed.'
