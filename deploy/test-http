#!/usr/bin/env bash
# Integration test in disposable directories; no sudo or installed wiki required.
# Requires nginx, fcgiwrap, Git, curl, and ordinary Unix utilities.
set -euo pipefail
deployment=$(cd -- "$(dirname -- "$0")" && pwd)
nginx=${WIKI_TEST_NGINX:-$(command -v nginx)}
fcgiwrap=${WIKI_TEST_FCGIWRAP:-$(command -v fcgiwrap)}
mime_types=${WIKI_TEST_MIME_TYPES:-/etc/nginx/mime.types}
port=${WIKI_TEST_PORT:-18080}
[[ "$port" =~ ^[0-9]+$ ]] || exit 1
fixture=$(mktemp -d /tmp/wiki-http-test.XXXXXXXX)
nginx_pid=
fcgi_pid=
cleanup() {
    if [[ -n "$nginx_pid" ]]; then kill "$nginx_pid" 2>/dev/null || true; wait "$nginx_pid" 2>/dev/null || true; fi
    if [[ -n "$fcgi_pid" ]]; then kill "$fcgi_pid" 2>/dev/null || true; wait "$fcgi_pid" 2>/dev/null || true; fi
    rm -rf -- "$fixture"
}
trap cleanup EXIT
export GIT_CONFIG_NOSYSTEM=1 GIT_CONFIG_GLOBAL=/dev/null
export GIT_AUTHOR_NAME=Test GIT_AUTHOR_EMAIL=test@example.invalid
export GIT_COMMITTER_NAME=Test GIT_COMMITTER_EMAIL=test@example.invalid
mkdir -p "$fixture/srv/queue" "$fixture/srv/www/current" "$fixture/hooks" "$fixture/home/.config/wiki-tokens"
printf 'static wiki\n' > "$fixture/srv/www/current/index.html"
git init --bare --initial-branch=main "$fixture/srv/source.git" >/dev/null
repository="$fixture/srv/source.git"
git --git-dir="$repository" config receive.denyNonFastForwards true
git --git-dir="$repository" config receive.denyDeletes true
git --git-dir="$repository" config http.getanyfile false
touch "$repository/git-daemon-export-ok"
git --git-dir="$repository" config core.hooksPath "$fixture/hooks"
sed "s|/srv/wiki|$fixture/srv|g" "$deployment/post-receive" > "$fixture/hooks/post-receive"
chmod +x "$fixture/hooks/post-receive"
cat > "$fixture/backend" <<EOF
#!/bin/sh
test -z "\${HTTP_AUTHORIZATION:-}\${HTTP_COOKIE:-}\${HTTP_X_EXEDEV_AUTHORIZATION:-}" || exit 1
exec '$(git --exec-path)/git-http-backend'
EOF
chmod +x "$fixture/backend"
# Only paths, the unprivileged test listener, and worker identity differ from prod.
# Override distribution-specific temp paths so the test needs no root privileges.
awk -v fixture="$fixture" '{ print } /^http \{/ {
    print "client_body_temp_path " fixture "/client-temp;"
    print "fastcgi_temp_path " fixture "/fastcgi-temp;"
    print "proxy_temp_path " fixture "/proxy-temp;"
    print "uwsgi_temp_path " fixture "/uwsgi-temp;"
    print "scgi_temp_path " fixture "/scgi-temp;"
}' "$deployment/nginx.conf" | sed -e '/^user /d' -e 's/worker_processes auto/worker_processes 1/' \
    -e "s|/run/wiki-nginx.pid|$fixture/nginx.pid|g" \
    -e "s|/var/log/nginx/wiki-error.log|$fixture/error.log|g" \
    -e "s|/var/log/nginx/wiki-access.log|$fixture/access.log|g" \
    -e "s|/etc/nginx/mime.types|$mime_types|g" \
    -e "s|listen 8080;|listen 127.0.0.1:$port;|" -e '/listen \[::\]:8080;/d' \
    -e "s|/srv/wiki|$fixture/srv|g" \
    -e "s|/run/wiki-git.socket|$fixture/git.socket|g" \
    -e "s|/usr/lib/git-core/git-http-backend|$fixture/backend|g" > "$fixture/nginx.conf"
"$nginx" -e stderr -p "$fixture/" -t -c "$fixture/nginx.conf"
"$fcgiwrap" -f -s "unix:$fixture/git.socket" > "$fixture/fcgi.log" 2>&1 &
fcgi_pid=$!
for ((i=0; i<50; i++)); do [[ -S "$fixture/git.socket" ]] && break; sleep 0.1; done
"$nginx" -e stderr -p "$fixture/" -c "$fixture/nginx.conf" -g 'daemon off;' &
nginx_pid=$!
base="http://127.0.0.1:$port"
for ((i=0; i<50; i++)); do curl -sf "$base/" >/dev/null && break; sleep 0.1; done
[[ "$(curl -fsS "$base/")" == 'static wiki' ]]
status() { curl -sS -o /dev/null -w '%{http_code}' "$@"; }
[[ "$(status "$base/source.git/info/refs?service=git-upload-pack")" == 403 ]]
[[ "$(status -X POST "$base/source.git/git-receive-pack")" == 403 ]]
[[ "$(status -u token:unverified "$base/source.git/info/refs?service=git-receive-pack")" == 403 ]]
[[ "$(status -H 'X-ExeDev-UserID: test-author' "$base/source.git/config")" == 404 ]]
[[ "$(status -H 'X-ExeDev-UserID: test-author' "$base/source.git/HEAD")" == 403 ]]
[[ "$(status "$base/.git/config")" == 403 ]]
[[ "$(status "$base/other.git/info/refs")" == 404 ]]
git init --initial-branch=main "$fixture/author" >/dev/null
printf 'first\n' > "$fixture/author/index.qmd"
git -C "$fixture/author" add .
git -C "$fixture/author" commit -qm first
git -C "$fixture/author" remote add origin "$base/source.git"
# The local test simulates the trusted proxy's identity assertion, not token verification.
http_git() { git -c http.extraHeader='X-ExeDev-UserID: test-author' "$@"; }
http_git -C "$fixture/author" push origin main
[[ -f "$fixture/srv/queue/pending" ]]
rm "$fixture/srv/queue/pending"
http_git clone "$base/source.git" "$fixture/reader"
cmp "$fixture/author/index.qmd" "$fixture/reader/index.qmd"
GIT_TRACE_PACKET="$fixture/packets" http_git -c protocol.version=2 ls-remote "$base/source.git" >/dev/null
grep -q 'version 2' "$fixture/packets"
# Exercise a body above NGINX's default 1 MiB limit and credential header stripping.
dd if=/dev/urandom of="$fixture/author/data.bin" bs=1024 count=2048 2>/dev/null
git -C "$fixture/author" add .
git -C "$fixture/author" commit -qm second
http_git -c http.extraHeader='Authorization: Basic fake' \
    -c http.extraHeader='Cookie: fake' -c http.extraHeader='X-Exedev-Authorization: Bearer fake' \
    -C "$fixture/author" push origin main
http_git -C "$fixture/reader" pull --ff-only
cmp "$fixture/author/data.bin" "$fixture/reader/data.bin"
rm "$fixture/srv/queue/pending"
http_git -C "$fixture/author" push origin main:other
[[ ! -e "$fixture/srv/queue/pending" ]]
git -C "$fixture/author" reset --hard HEAD~1 >/dev/null
if http_git -C "$fixture/author" push --force origin main; then echo 'Force push unexpectedly accepted' >&2; exit 1; fi
if http_git -C "$fixture/author" push origin :main; then echo 'Branch deletion unexpectedly accepted' >&2; exit 1; fi

# The helper selects the destination host, refuses HTTP, and ignores store/erase.
printf 'test-token-a\n' > "$fixture/home/.config/wiki-tokens/a.exe.xyz"
printf 'test-token-b\n' > "$fixture/home/.config/wiki-tokens/b.exe.xyz"
credential() { printf 'protocol=%s\nhost=%s\n\n' "$1" "$2" | HOME="$fixture/home" sh "$deployment/git-credential-wiki" "${3:-get}"; }
[[ "$(credential https a.exe.xyz)" == $'username=token\npassword=test-token-a' ]]
[[ "$(credential https b.exe.xyz)" == $'username=token\npassword=test-token-b' ]]
[[ -z "$(credential http a.exe.xyz)" ]]
[[ -z "$(credential https absent.exe.xyz)" ]]
[[ -z "$(credential https ../a.exe.xyz)" ]]
[[ -z "$(credential https a.exe.xyz store)" ]]
[[ -z "$(credential https a.exe.xyz erase)" ]]
# Exercise Git's actual credential protocol and the documented URL-scoped setup.
export GIT_CONFIG_GLOBAL="$fixture/gitconfig"
git config --global credential.https://a.exe.xyz.username token
git config --global credential.https://a.exe.xyz.helper ''
git config --global --add credential.https://a.exe.xyz.helper "!sh '$deployment/git-credential-wiki'"
resolved=$(printf 'url=https://a.exe.xyz/source.git\n\n' | HOME="$fixture/home" GIT_TERMINAL_PROMPT=0 git credential fill)
[[ "$resolved" == *'password=test-token-a'* ]]
if printf 'url=https://unrelated.exe.xyz/source.git\n\n' | HOME="$fixture/home" GIT_TERMINAL_PROMPT=0 git credential fill >/dev/null 2>&1; then
    echo 'Credentials unexpectedly supplied for an unrelated host' >&2; exit 1
fi
echo 'HTTP clone/push, access checks, hook, v2, large push, push policies, and token helper passed.'
