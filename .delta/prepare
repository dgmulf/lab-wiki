#!/bin/sh

set -eu

# Cloud Runners call prepare before setup has installed the toolchains.
# setup calls us again once those tools are available.
if command -v delta-runner >/dev/null 2>&1 &&
    [ "${LAB_WIKI_CLOUD_TOOLS_READY:-0}" != 1 ]; then
    echo "Deferring checkout preparation to .delta/setup."
    exit 0
fi

cd "$(dirname "$0")/.."
export PATH="$HOME/.local/bin:$PATH"
if ! command -v mise >/dev/null 2>&1; then
    echo "Install Mise and activate it in your shell before running .delta/prepare." >&2
    exit 1
fi

# Trust only this checkout's configuration, then use the same environment
# that Mise supplies to interactive shells.
mise trust "$PWD/mise.toml"
mise exec -- uv sync --locked
mise exec -- rv sync --locked
mise exec -- npx --yes skills experimental_install
